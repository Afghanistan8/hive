# GenLayer Studio Next (Consensus v0.6 preview). Keep RPC, chain ID and name together.
# studio-next.genlayer.com and studio-dev.genlayer.com serve the same chain (61997).
NEXT_PUBLIC_GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
NEXT_PUBLIC_GENLAYER_CHAIN_ID=61997
NEXT_PUBLIC_GENLAYER_CHAIN_NAME=GenLayer Studio Next
NEXT_PUBLIC_GENLAYER_SYMBOL=GEN

# Deployed HIVE contracts (public addresses; see deploy/deployments.json)
NEXT_PUBLIC_HIVE_CRYPTO_ADDRESS=0x6172565eA61CEa77c8E6d1fBed36936009C10FF1
NEXT_PUBLIC_HIVE_SPORTS_ADDRESS=0xeE172062d021f4dE2B4fEbad0B945e769a62C954

NEXT_PUBLIC_EXPLORER_URL=https://explorer-studio-dev.genlayer.com

# Public site URL (used for link previews / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Supabase read-mirror (optional; app falls back to contract reads) ----
# Public: project URL + anon key (RLS makes every table SELECT-only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- Server-only secrets: set in Vercel env, never commit, never prefix NEXT_PUBLIC_ ----
# SUPABASE_SERVICE_ROLE_KEY=   keeper writes the mirror
# KEEPER_PRIVATE_KEY=          funded wallet for permissionless keeper txs (no privileges)
# CRON_SECRET=                 bearer token Vercel Cron / GitHub Actions send to /api/cron/keeper
